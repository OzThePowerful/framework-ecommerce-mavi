# Credenciales privadas del equipo — copiar a `.env` y completar.
# `.env` está gitignored; este archivo solo documenta los nombres.
# Las tarjetas de prueba son ficticias (sandbox) y viven versionadas
# en data/<sitio>/payment.yaml — NO van en .env.

# Comprador invitado — Muebles América (email real: el checkout lo
# valida contra un servicio externo; MOTHERS_NAME es opcional)
MAVI_GUEST_MA_FIRST_NAME=
MAVI_GUEST_MA_LAST_NAME=
MAVI_GUEST_MA_MOTHERS_NAME=
MAVI_GUEST_MA_EMAIL=
MAVI_GUEST_MA_PHONE=

# Comprador invitado — VIU
MAVI_GUEST_VIU_FIRST_NAME=
MAVI_GUEST_VIU_LAST_NAME=
MAVI_GUEST_VIU_MOTHERS_NAME=
MAVI_GUEST_VIU_EMAIL=
MAVI_GUEST_VIU_PHONE=

# Login — cuenta de prueba Muebles América (stage)
MAVI_LOGIN_MA_EMAIL=
MAVI_LOGIN_MA_PASSWORD=

# Login — cuenta de prueba VIU (stage)
MAVI_LOGIN_VIU_EMAIL=
MAVI_LOGIN_VIU_PASSWORD=

# API — credenciales/keys del ambiente (uso futuro API-First)
MAVI_API_BASE_URL=
MAVI_API_KEY=
MAVI_API_SECRET=
